<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="saecdata.proyectoProductosAlbert.controllers.MainController">
    <children>
        <!-- Título -->
        <Text text="Bienvenido al Sistema" layoutX="150" layoutY="50" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <!-- Botón de Iniciar sesión -->
        <Button text="Iniciar sesión" layoutX="150" layoutY="120" onAction="#handleLoginView"/>

        <!-- Botón de Registrarse -->
        <Button text="Registrarse" layoutX="150" layoutY="180" onAction="#handleRegisterView"/>

    </children>
</AnchorPane>
