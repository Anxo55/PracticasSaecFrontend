<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Alert?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="saecdata.proyectoProductosAlbert.controllers.LoginController">
    <children>
        <!-- Título -->
        <Text text="Iniciar Sesión" layoutX="170" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <!-- Campo de Usuario -->
        <TextField fx:id="usernameField" promptText="Nombre de usuario" layoutX="150" layoutY="80" prefWidth="200"/>
        
        <!-- Campo de Contraseña -->
        <PasswordField fx:id="passwordField" promptText="Contraseña" layoutX="150" layoutY="140" prefWidth="200"/>

        <!-- Botón de Iniciar sesión -->
        <Button text="Iniciar sesión" layoutX="150" layoutY="200" onAction="#handleLogin"/>

        <!-- Botón de Registrarse -->
        <Button text="Registrarse" layoutX="150" layoutY="250"/>

    </children>
</AnchorPane>
